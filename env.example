# Copy to .env and fill in. Never commit .env.
# API keys: Sitecore Cloud Portal > your Personalize tenant > Developer settings / API keys
# Base URL by region:
#   US https://api-engage-us.sitecorecloud.io   EU https://api-engage-eu.sitecorecloud.io
#   AP https://api-engage-ap.sitecorecloud.io   JP https://api-engage-jpe.sitecorecloud.io

SOURCE_BASE_URL=https://api-engage-us.sitecorecloud.io
SOURCE_CLIENT_ID=dev-api-key
SOURCE_CLIENT_SECRET=dev-api-secret

TARGET_BASE_URL=https://api-engage-us.sitecorecloud.io
TARGET_CLIENT_ID=prod-api-key
TARGET_CLIENT_SECRET=prod-api-secret

# Optional overrides
# SC_AUTH_URL=https://auth.sitecorecloud.io/oauth/token
# SC_AUDIENCE=https://api.sitecorecloud.io
